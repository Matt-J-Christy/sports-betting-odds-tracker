# Version control
.git
.gitignore

# Environment & Secrets (NEVER bake credentials into Docker images)
.env
.env.*
*.pem
*.key
credentials.json

# Local Virtual Environments
odds/
venv/
.venv/
env/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Editor & IDE settings
.vscode/
.idea/
*.swp
*.swo

# Notebooks & temporary data
.ipynb_checkpoints/
scratch/
temp_*

# Documentation & AI guides (not needed at container runtime)
repo_updates/
